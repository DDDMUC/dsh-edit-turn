{
  "name": "dsh-edit-turn",
  "version": "0.5.12",
  "description": "Edit any message in DeepSeek Harness in place: a prompt is replaced where it stands; a model reply block (answer text or reasoning) is patched through a plugin record and a message projection, so the turn stays where it is, later turns are untouched and the log grows by one small record. Falls back to the replay splice on hosts without the projection API. The append-only session log is never rewritten.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/patch.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "edit",
    "message",
    "turn",
    "projection",
    "reasoning",
    "surface-replace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-edit-turn.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "verify:contract": "node tools/verify-surface-contract.mjs",
    "verify:client": "node tools/verify-client-static.mjs",
    "verify:live": "node tools/verify-live-client.mjs",
    "verify:profile": "bash tools/verify-dsh-plugin.sh",
    "probe:loaded": "node tools/probe-loaded.mjs",
    "check": "npm run test && npm run verify:contract && npm run verify:client",
    "verify:ui": "node tools/verify-live-ui.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "^0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "engines": {
      "dsh": ">=0.1.6-alpha.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.6-alpha.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
